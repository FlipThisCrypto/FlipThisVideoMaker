FTVM_DATABASE_URL=sqlite:///./data/flipthis.db
FTVM_DATA_DIR=./projects
FTVM_MODEL_DIR=./models
FTVM_CACHE_DIR=./.cache
FTVM_FFMPEG_PATH=ffmpeg
FTVM_FFPROBE_PATH=ffprobe
FTVM_PROVIDER_CONFIG=./config/providers.yaml
FTVM_WORKER_CONFIG=./config/workers.yaml
FTVM_RENDER_PROFILE_CONFIG=./config/render-profiles.yaml
FTVM_WORKER_HEARTBEAT_SECONDS=5
FTVM_WORKER_STALE_SECONDS=20
FTVM_JOB_LEASE_SECONDS=30
FTVM_BIND_HOST=127.0.0.1
FTVM_BIND_PORT=8000
FTVM_MAX_UPLOAD_MB=100
FTVM_MAX_JOB_RETRIES=2
FTVM_MAX_CPU_JOBS=2
FTVM_DEFAULT_RENDER_PROFILE=draft
FTVM_MIN_FREE_VRAM_MB=2000
FTVM_AUTH_MODE=local
FTVM_LOG_LEVEL=INFO
FTVM_WATERMARK_ENABLED=false
# FTVM_HF_TOKEN_FILE=/path/to/a/local/token-file
